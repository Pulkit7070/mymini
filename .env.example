# ===========================================================================
# You need TWO keys: one model provider and one web search provider.
# Both have free tiers that need no card. Copy this file to .env and fill in.
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. MODEL — set exactly one. Auto-detected in this order.
# ---------------------------------------------------------------------------

# Groq — free, no card, very fast. https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Anthropic — best answer quality. https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
# Any OpenAI-compatible endpoint works (Together, vLLM, LM Studio, Ollama):
# OPENAI_BASE_URL=http://localhost:11434/v1

# OpenRouter — one key, many models. https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-...

# Force a provider instead of auto-detecting: anthropic | groq | openai | openrouter
# LLM_PROVIDER=groq

# Override the models. Defaults are chosen per provider; see src/config.ts.
# MODEL=llama-3.3-70b-versatile
# FAST_MODEL=llama-3.1-8b-instant

# ---------------------------------------------------------------------------
# 2. WEB SEARCH — set exactly one. Auto-detected in this order.
# ---------------------------------------------------------------------------

# Tavily — free tier, no card, returns page content with results. https://app.tavily.com
TAVILY_API_KEY=tvly-...

# Brave Search API — https://api-dashboard.search.brave.com
# BRAVE_API_KEY=

# Exa — https://dashboard.exa.ai
# EXA_API_KEY=

# Serper (Google) — https://serper.dev
# SERPER_API_KEY=

# Force a provider: tavily | brave | exa | serper
# SEARCH_PROVIDER=tavily

# ---------------------------------------------------------------------------
# 3. Optional
# ---------------------------------------------------------------------------
# PORT=3000
# IANA timezone used to resolve "Monday", "last Tuesday", "3 November".
# Defaults to the machine's timezone.
# TIMEZONE=Europe/London
# Where conversation memory is persisted (append-only JSONL).
# DATA_DIR=./data

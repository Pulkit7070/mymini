{
  "name": "mymini",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A chat agent with web search that remembers what it told you and can re-check whether it is still true.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "cli": "tsx src/cli.ts",
    "seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "selftest": "tsx scripts/selftest.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@types/node": "^22.18.8",
    "typescript": "^5.9.3"
  }
}
